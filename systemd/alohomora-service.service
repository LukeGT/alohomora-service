[Unit]
Description=Alohomora Secret Service (org.freedesktop.secrets)
After=network.target alohomora-web.service

[Service]
Type=simple
User=root
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="ALOHOMORA_INTERNAL_PORT=19969"
Environment="ALOHOMORA_NOTIFICATION_URL=http://127.0.0.1:19922/send-notification"
Environment="ALOHOMORA_AUTH_TIMEOUT_SECS=3600"
Environment="PASSWORD_STORE_DIR=/home/ubuntu/.password-store"
Environment="GNUPGHOME=/home/ubuntu/.gnupg"
Environment="HOME=/home/ubuntu"
ExecStart=/home/ubuntu/projects/alohomora-service/target/release/pass-secret-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
