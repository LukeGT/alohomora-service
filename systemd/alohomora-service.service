[Unit]
Description=Alohomora Secret Service (org.freedesktop.secrets)
After=network.target

[Service]
Type=simple
User=root
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="ALOHOMORA_INTERNAL_PORT=19969"
Environment="ALOHOMORA_AUTH_TIMEOUT_SECS=3600"
Environment="PASSWORD_STORE_DIR=/home/ubuntu/.password-store"
# Root-owned: gpg, run as root here, obeys gpg.conf in its home (agent-program runs any program).
Environment="GNUPGHOME=/var/lib/alohomora-service/gnupg"
Environment="HOME=/var/lib/alohomora-service"
# Holds the root-only sudo approval socket.
RuntimeDirectory=alohomora
RuntimeDirectoryMode=0700
# A root-owned copy from pam/install.sh; never run a binary from the build tree as root.
ExecStart=/usr/local/lib/alohomora/pass-secret-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
