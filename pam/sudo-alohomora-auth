#!/bin/bash -p
set -u

# Runs as root on sudo's behalf: trust nothing inherited. -p above ignores BASH_ENV.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset IFS CDPATH GLOBIGNORE ENV

# Identify the user's terminal. This must match the guard in pam-sudo (PAM_TTY is a /dev path);
# sudo-rs sets PAM_TTY only when it has a tty, and aborts if a PAM message arrives without one.
TTY_DEV=""
if [[ "${PAM_TTY:-}" == /dev/* ]]; then
    TTY_DEV="$PAM_TTY"
fi

# Explain a failed approval: to the terminal, else (pam_exec output would make sudo-rs abort) to
# the stderr of sudo's parent, since sudo itself is root-owned. Always log to the journal too.
explain() {
    logger -t alohomora-sudo "$1"
    if [ -n "$TTY_DEV" ] && [ -w "$TTY_DEV" ]; then
        printf "\nAlohomora: %s; falling back to password authentication.\n" "$1" > "$TTY_DEV"
    else
        # Reopened with the user's own rights: the caller chooses what this fd refers to, and as
        # root this write could append to any file it had opened with O_PATH. The group must be the
        # user's too, or the kernel refuses access to the caller's /proc entry.
        local user="${PAM_RUSER:-${PAM_USER:-nobody}}"
        setpriv --reuid="$(id -u "$user")" --regid="$(id -g "$user")" --clear-groups \
            sh -c 'echo "Alohomora: $1, and there is no terminal for password authentication." >> "$2"' \
            sh "$1" "/proc/$(ps -o ppid= -p "$PPID" | tr -d ' ')/fd/2" 2>/dev/null
    fi
}

# Fall back immediately to password if Alohomora service is inactive
if ! systemctl is-active --quiet alohomora-service; then
    explain "the alohomora-service is not running"
    exit 1
fi

# Ask the daemon over its root-only socket; never the session bus, which the user controls.
/usr/local/lib/alohomora/alohomora-sudo-approve >/dev/null 2>&1 &
SECRET_PID=$!

# Ensure the background request is cleaned up on script exit
trap 'kill "$SECRET_PID" 2>/dev/null; wait "$SECRET_PID" 2>/dev/null' EXIT INT TERM

# If a valid terminal is available and accessible, prompt and monitor Enter key
if [ -n "$TTY_DEV" ] && [ -r "$TTY_DEV" ] && [ -w "$TTY_DEV" ]; then
    printf "Alohomora push sent. Press Enter for password: " > "$TTY_DEV"
    while kill -0 "$SECRET_PID" 2>/dev/null; do
        if read -t 0.2 -r _ < "$TTY_DEV" 2>/dev/null; then
            # User pressed Enter: abort push and drop to password prompt
            kill "$SECRET_PID" 2>/dev/null
            wait "$SECRET_PID" 2>/dev/null
            printf "\n" > "$TTY_DEV"
            exit 1
        fi
    done
fi

wait "$SECRET_PID" 2>/dev/null
STATUS=$?

if [ $STATUS -eq 0 ]; then
    if [ -n "$TTY_DEV" ] && [ -w "$TTY_DEV" ]; then
        printf "\n" > "$TTY_DEV"
    fi
    exit 0
else
    explain "phone approval was not received (denied, timed out, or the relay was unreachable)"
    exit 1
fi
